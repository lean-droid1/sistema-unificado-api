# ═══════════════════════════════════════════════════════════
# Variables de entorno — Backend Sistema Unificado
# ═══════════════════════════════════════════════════════════

# Base de datos (Railway la genera automáticamente)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Auth
JWT_SECRET=cambiar-esta-clave-secreta-2026

# Frontend
FRONTEND_URL=https://tu-dominio.vercel.app
NODE_ENV=production
PORT=3000

# ═══════════════════════════════════════════════════════════
# ANDREANI (pedir credenciales a apis@andreani.com)
# ═══════════════════════════════════════════════════════════
ANDREANI_USER=
ANDREANI_PASS=
ANDREANI_CLIENTE=
ANDREANI_CONTRATO=AND00EST
ANDREANI_CP_ORIGEN=1888
ANDREANI_DEBUG=false
# true = usa sandbox (apisqa.andreani.com), false = producción

# ═══════════════════════════════════════════════════════════
# CLOUDINARY (imágenes) — las 3 son OBLIGATORIAS o no sube fotos
# Sacalas de cloudinary.com -> Settings -> API Keys
# OJO: copialas EXACTAS, respetando mayúsculas/minúsculas
# ═══════════════════════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ADMIN inicial (se crea solo en el primer arranque si no hay admin)
ADMIN_PASSWORD=Admin1234
